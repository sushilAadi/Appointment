# ---------------------------------------------------------------------------
# DATABASE (Supabase — accessed via the Supabase JS client, no Prisma)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL: Supabase Dashboard -> Project Settings -> Data
# API -> "Project URL". You likely already have this.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Project Settings -> API Keys -> "service_role"
# secret (NOT the "anon" / "publishable" key — that one is safe to expose to
# browsers and can't write to these tables; the service_role key is secret,
# server-only, and bypasses Row Level Security). Never prefix this with
# NEXT_PUBLIC_ or it will be shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ---------------------------------------------------------------------------
# META WHATSAPP CLOUD API
# ---------------------------------------------------------------------------
# Meta for Developers -> Your App -> WhatsApp -> API Setup
WHATSAPP_TOKEN="your-permanent-or-temporary-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-whatsapp-phone-number-id"
# Any string you choose. You will enter the SAME value in the Meta webhook
# configuration screen ("Verify token").
WHATSAPP_VERIFY_TOKEN="choose-a-random-secret-string"
WHATSAPP_GRAPH_API_VERSION="v25.0"

# The doctor's own WhatsApp number, in international format WITHOUT the
# leading "+" (e.g. 15551234567). Messages arriving from this number are
# treated as the doctor, not a patient.
DOCTOR_WHATSAPP_NUMBER="15551234567"
DOCTOR_NAME="Dr. Smith"
CLINIC_NAME="Sunrise Family Clinic"

# ---------------------------------------------------------------------------
# GOOGLE CLOUD (Calendar + Sheets) - Service Account
# ---------------------------------------------------------------------------
# Google Cloud Console -> IAM & Admin -> Service Accounts -> Keys -> Create
# key (JSON). Copy the "client_email" and "private_key" fields below.
# IMPORTANT: keep the \n characters in the private key literal (do not
# convert to real newlines) — the app converts them at runtime.
GOOGLE_SERVICE_ACCOUNT_EMAIL="booking-bot@your-project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Calendar to write appointments to. Share this calendar with the
# service account email above (Settings and sharing -> Share with specific
# people -> "Make changes to events"). Use "primary" only if you have
# domain-wide delegation set up (not the default here).
GOOGLE_CALENDAR_ID="your-calendar-id@group.calendar.google.com"

# Google Sheet used as a running log of every appointment. Share the sheet
# with the service account email above as "Editor". The ID is the long
# string in the sheet URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID="your-google-sheet-id"
GOOGLE_SHEET_TAB_NAME="Appointments"

# ---------------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------------
# Public base URL of this deployment (used only for logging/links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
